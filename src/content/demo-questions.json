[
  {"id": "DEMO-1-1", "stage": 1, "type": "concept", "difficulty": 1, "stem": "工作場所有立即發生危險之虞時，誰應即令停止作業，並使勞工退避至安全場所？", "options": [{"key": "A", "text": "勞動檢查員"}, {"key": "B", "text": "承攬商"}, {"key": "C", "text": "雇主或工作場所負責人"}, {"key": "D", "text": "消防局"}], "answer": "C", "explanation": "工作場所有立即發生危險之虞時，雇主或工作場所負責人應即令停止作業，並使勞工退避至安全場所。", "pages": [25]},
  {"id": "DEMO-1-2", "stage": 1, "type": "concept", "difficulty": 1, "stem": "依職業安全衛生法，「雇主」是指？", "options": [{"key": "A", "text": "事業主或事業之經營負責人"}, {"key": "B", "text": "受僱從事工作獲致工資者"}, {"key": "C", "text": "工作場所的所有人員"}, {"key": "D", "text": "勞動檢查員"}], "answer": "A", "explanation": "雇主是指事業主或事業之經營負責人；受僱從事工作獲致工資者是勞工。", "pages": [6]},
  {"id": "DEMO-1-3", "stage": 1, "type": "scenario", "difficulty": 2, "stem": "在道路上施工，未採取交通管制措施，也沒有設置安全防護設施。依教材屬於？", "options": [{"key": "A", "text": "一般風險，不需特別處理"}, {"key": "B", "text": "僅屬行政程序疏失"}, {"key": "C", "text": "天災，無法預防"}, {"key": "D", "text": "有立即發生危險之虞的情形"}], "answer": "D", "explanation": "施行細則所列立即發生危險之虞的情形，包括於道路或鄰接道路作業，未採取管制措施及未設置安全防護設施。", "pages": [27]},
  {"id": "DEMO-2-1", "stage": 2, "type": "concept", "difficulty": 1, "stem": "工作中「做不必要的跑步」屬於下列何者？", "options": [{"key": "A", "text": "不安全狀況"}, {"key": "B", "text": "不安全行為"}, {"key": "C", "text": "天災"}, {"key": "D", "text": "危害物"}], "answer": "B", "explanation": "做不必要的跑步是教材所列的不安全行為。", "pages": [34]},
  {"id": "DEMO-2-2", "stage": 2, "type": "concept", "difficulty": 1, "stem": "依教材，新進人員容易發生職災的常見心態是？", "options": [{"key": "A", "text": "知法犯法"}, {"key": "B", "text": "回鍋太清楚"}, {"key": "C", "text": "不知道"}, {"key": "D", "text": "大概知道"}], "answer": "C", "explanation": "教材描述新進人員「不知道」、老手「知法犯法」、換單位人員「大概知道」、回鍋人員「回鍋太清楚」。", "pages": [31]},
  {"id": "DEMO-2-3", "stage": 2, "type": "practice", "difficulty": 1, "stem": "機械正在運轉中，下列哪一個行為屬於不安全行為？", "options": [{"key": "A", "text": "靠近或碰觸運轉中的機械裝置"}, {"key": "B", "text": "停機並上鎖後再清理"}, {"key": "C", "text": "保持在防護欄外操作"}, {"key": "D", "text": "依 SOP 操作控制面板"}], "answer": "A", "explanation": "靠近或碰觸正在運轉中的機械裝置，是教材所列接近危險區域的不安全行為。", "pages": [33]},
  {"id": "DEMO-3-1", "stage": 3, "type": "concept", "difficulty": 1, "stem": "安全衛生工作守則報備後公告實施，對員工有什麼影響？", "options": [{"key": "A", "text": "員工可自行決定是否遵守"}, {"key": "B", "text": "只適用於主管"}, {"key": "C", "text": "只在年度稽核時有效"}, {"key": "D", "text": "提供 SOP，使員工有遵守的依據"}], "answer": "D", "explanation": "教材列出工作守則提供安全衛生準則與 SOP，使員工有遵守依據，公告實施後對員工行為具有約束力。", "pages": [42]},
  {"id": "DEMO-3-2", "stage": 3, "type": "practice", "difficulty": 1, "stem": "定期檢查與重點檢查開始前，應事先準備什麼？", "options": [{"key": "A", "text": "年度預算表"}, {"key": "B", "text": "完善的檢查表格"}, {"key": "C", "text": "員工旅遊計畫"}, {"key": "D", "text": "人事命令"}], "answer": "B", "explanation": "定期檢查、重點檢查應事先製作完善的檢查表格，檢查時有所依循，檢查後能予記錄備查。", "pages": [46]},
  {"id": "DEMO-3-3", "stage": 3, "type": "concept", "difficulty": 1, "stem": "安全作業標準的目的為何？", "options": [{"key": "A", "text": "增加作業步驟以延長工時"}, {"key": "B", "text": "取代所有教育訓練"}, {"key": "C", "text": "消除作業時不安全的行為、設備與環境"}, {"key": "D", "text": "作為績效考核的唯一依據"}], "answer": "C", "explanation": "安全作業標準經由工作安全分析，檢討危害與安全方法，以消除作業時不安全的行為、設備與環境。", "pages": [52]},
  {"id": "DEMO-4-1", "stage": 4, "type": "concept", "difficulty": 1, "stem": "甲（A）類火災的可燃物是？", "options": [{"key": "A", "text": "木材、紙張、紡織品"}, {"key": "B", "text": "汽油、溶劑"}, {"key": "C", "text": "通電中的電氣設備"}, {"key": "D", "text": "鎂、鈉等金屬"}], "answer": "A", "explanation": "甲類為一般可燃性固體，如木材、紙張、紡織品、塑膠。", "pages": [80]},
  {"id": "DEMO-4-2", "stage": 4, "type": "practice", "difficulty": 1, "stem": "管線漏油起火，關閉進料閥停止輸送，屬於哪一種滅火方法？", "options": [{"key": "A", "text": "冷卻法"}, {"key": "B", "text": "窒息法"}, {"key": "C", "text": "抑制法"}, {"key": "D", "text": "隔離法"}], "answer": "D", "explanation": "隔離法是將燃燒中的物質移開或斷其供應，例如關閉進料閥、停止輸送。", "pages": [76]},
  {"id": "DEMO-4-3", "stage": 4, "type": "practice", "difficulty": 1, "stem": "撥打 119 求救時，應說明哪些事項？", "options": [{"key": "A", "text": "只說自己的姓名"}, {"key": "B", "text": "地點、傷情、人數、姓名及所需支援"}, {"key": "C", "text": "只說公司名稱"}, {"key": "D", "text": "不需說明，接通即可掛斷"}], "answer": "B", "explanation": "教材提醒撥打 119 應說明地點、傷情、人數、姓名及所需支援事宜。", "pages": [89]},
  {"id": "DEMO-5-1", "stage": 5, "type": "concept", "difficulty": 1, "stem": "教材所列職災保險投保薪資的下限為？", "options": [{"key": "A", "text": "新臺幣 1 萬元"}, {"key": "B", "text": "沒有下限"}, {"key": "C", "text": "基本工資"}, {"key": "D", "text": "新臺幣 72,800 元"}], "answer": "C", "explanation": "教材所列職災保險投保薪資上限 72,800 元，下限為基本工資。", "pages": [105]},
  {"id": "DEMO-5-2", "stage": 5, "type": "concept", "difficulty": 1, "stem": "共同作業時，協議組織應指定誰擔任指揮及協調工作？", "options": [{"key": "A", "text": "會計人員"}, {"key": "B", "text": "外部法律顧問"}, {"key": "C", "text": "承攬商業務員"}, {"key": "D", "text": "工作場所負責人"}], "answer": "D", "explanation": "原事業單位應設置協議組織，並指定工作場所負責人擔任指揮及協調之工作。", "pages": [99]},
  {"id": "DEMO-5-3", "stage": 5, "type": "concept", "difficulty": 1, "stem": "職災保險的失能、遺屬年金依什麼標準發給？", "options": [{"key": "A", "text": "被保險人平均月投保薪資的一定比率"}, {"key": "B", "text": "固定金額"}, {"key": "C", "text": "工作年資"}, {"key": "D", "text": "最高學歷"}], "answer": "A", "explanation": "教材所列失能、遺屬年金依被保險人平均月投保薪資一定比率發給。", "pages": [106]}
